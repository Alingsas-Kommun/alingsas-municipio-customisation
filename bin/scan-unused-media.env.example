# Copy to scan-unused-media.env next to scan-unused-media.sh and edit.
# Every line is optional; the script has production defaults.
#WP_URL=https://www.alingsas.se
#WP_BIN=/usr/local/bin/wp
#WP_PATH=/usr/local/akwww_root/www/wp
#WP_EXTRA_ARGS=--allow-root
#MEDIA_TYPES="images pdfs"
#BATCH_SIZE=50
#BATCH_SIZE_IMAGES=50
#BATCH_SIZE_PDFS=50
#FIND_BATCH_SIZE=50
#PAUSE_MS=1000
#MIN_AGE_DAYS=90
#MARKDOWN_DIR=/usr/local/akwww_root/www/wp-content/uploads/networks/1/sites/2/worddown-export
#RUN_DIR=/usr/local/akwww_root/tmp/unused-images
